{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/**/*.mts", "scripts/**/*.mts", "eslint.config.mts", "vite.config.mts", "vite.mobile.config.mts", "src/renderer/global.d.ts"]
}
