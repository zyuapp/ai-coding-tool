{
  "name": "threadline",
  "version": "0.1.0",
  "private": true,
  "description": "A fast local desktop client for Claude coding tasks.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
