{
  "name": "claudex",
  "version": "0.1.11",
  "private": true,
  "license": "MIT",
  "author": "Zhuocheng Yu",
  "description": "A fast local desktop client for Claude coding tasks.",
  "homepage": "https://github.com/zyuapp/claudex",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare:cua": "node scripts/prepare-cua-driver.mjs",
    "start": "npm run prepare:cua && npm run build && electron .",
    "package:mac": "npm run prepare:cua && npm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@trycua/cua-driver": "^0.20.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "com.zyuapp.claudex",
    "productName": "Claudex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "!node_modules/@trycua/**",
      "!node_modules/@ubjs/**"
    ],
    "extraResources": [
      {
        "from": "vendor/cua-driver/cua-driver",
        "to": "cua-driver"
      },
      {
        "from": "node_modules/@trycua",
        "to": "cua-sdk/node_modules/@trycua"
      },
      {
        "from": "node_modules/@ubjs",
        "to": "cua-sdk/node_modules/@ubjs"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/claude"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true,
      "signIgnore": "Contents/Resources/cua-driver$",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Claudex uses Automation only when a requested computer-use action needs to communicate with another app.",
        "NSScreenCaptureUsageDescription": "Claudex captures app windows so Claude can see and interact with interfaces you ask it to control."
      },
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zyuapp",
        "repo": "claudex",
        "releaseType": "release"
      }
    ]
  }
}
