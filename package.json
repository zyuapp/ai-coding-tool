{
  "name": "ai-coding-tool",
  "version": "0.4.11",
  "private": true,
  "license": "MIT",
  "author": "Zhuocheng Yu",
  "description": "A fast local desktop client for Claude coding tasks.",
  "desktopName": "com.zyuapp.aicodingtool.desktop",
  "homepage": "https://github.com/zyuapp/ai-coding-tool",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "vite build && npm run build:mobile && tsc -p tsconfig.main.json",
    "build:mobile": "vite build --config vite.mobile.config.mts",
    "check": "npm run check:licenses && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json && npm run lint",
    "check:licenses": "node scripts/generate-legal-notices.mjs --check",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "npm run check && npm run build && vitest run",
    "prepare:electron": "install-electron",
    "prepare:cua": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/prepare-cua-driver.mts",
    "start": "npm run prepare:electron && npm run prepare:cua && npm run build && electron .",
    "package:mac": "npm run prepare:electron && npm run prepare:cua && npm run build && electron-builder --mac --arm64 --publish never",
    "package:linux": "npm run prepare:electron && npm run prepare:cua && npm run build && electron-builder --linux --publish never",
    "generate:codex-protocol": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-codex-protocol.mts",
    "generate:claude-baseline": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-claude-baseline.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@trycua/cua-driver": "0.23.2",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@openai/codex": "0.152.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "afterPack": "./scripts/verify-legal-package.mjs",
    "appId": "com.zyuapp.aicodingtool",
    "productName": "AI Coding Tool",
    "protocols": [
      {
        "name": "AI Coding Tool project",
        "schemes": [
          "aicodingtool"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "assets/**",
      "!assets/legal/**",
      "!dist/renderer/legal/**",
      "!dist/mobile/legal/**",
      "!node_modules/@trycua/**",
      "!node_modules/@ubjs/**",
      "!**/node_modules/@openai/codex-*/**/*",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "!**/node_modules/fast-uri/benchmark/**/*",
      "!**/node_modules/**/*.map",
      "!**/node_modules/zod/src/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/cua-driver/cua-driver",
        "to": "cua-driver"
      },
      {
        "from": "node_modules/@trycua",
        "to": "cua-sdk/node_modules/@trycua"
      },
      {
        "from": "node_modules/@ubjs/core",
        "to": "cua-sdk/node_modules/@ubjs/core"
      },
      {
        "from": "node_modules/@ubjs/node",
        "to": "cua-sdk/node_modules/@ubjs/node"
      },
      {
        "from": "assets/legal",
        "to": "legal"
      },
      {
        "from": "dist/renderer/legal/RENDERER-THIRD-PARTY-LICENSES.md",
        "to": "legal/RENDERER-THIRD-PARTY-LICENSES.md"
      },
      {
        "from": "dist/mobile/legal/MOBILE-THIRD-PARTY-LICENSES.md",
        "to": "legal/MOBILE-THIRD-PARTY-LICENSES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "legal/ELECTRON-MIT.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "legal/ELECTRON-THIRD-PARTY-NOTICES.html"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true,
      "signIgnore": "Contents/Resources/cua-driver$",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "AI Coding Tool uses Automation only when a requested computer-use action needs to communicate with another app.",
        "NSScreenCaptureUsageDescription": "AI Coding Tool captures app windows so Claude can see and interact with interfaces you ask it to control."
      },
      "icon": "assets/icon.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "AICodingTool-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "executableName": "aicodingtool",
      "icon": "assets/icon.png",
      "maintainer": "Zhuocheng Yu <zhuocheng.yu.d@gmail.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "AICodingTool-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageCategory": "devel",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "x11-utils"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zyuapp",
        "repo": "ai-coding-tool",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US"
    ]
  }
}
