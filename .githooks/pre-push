#!/bin/sh
# Runs the repo gate (licenses, typecheck, lint, build, vitest) before any push.
# Set SKIP_PREPUSH=1 to bypass.

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "pre-push: skipped (SKIP_PREPUSH=1)"
  exit 0
fi

# Nothing to verify when every ref in the push is a deletion.
has_updates=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) has_updates=1 ;;
  esac
done
[ "$has_updates" = "0" ] && exit 0

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules missing, installing..."
  npm ci || npm install || exit 1
fi

echo "pre-push: npm test"
npm test || {
  echo ""
  echo "pre-push: FAILED — push aborted. Fix the above, or bypass with SKIP_PREPUSH=1 git push."
  exit 1
}
